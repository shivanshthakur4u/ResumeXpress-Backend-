{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "node_modules/@napi-rs/**",
                    "node_modules/pdfjs-dist/**"
                ]
            }
        }
    ],
    "routes": [{ "src": "/(.*)", "dest": "index.js" }]
}
