# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string.
DB_URI=mongodb://127.0.0.1:27017/resumexpress

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters — the server refuses to start otherwise.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-me-with-a-32-plus-character-random-string
JWT_EXPIRES_IN=48h

# ─── Frontend / CORS ──────────────────────────────────────────────────────────
# Used to build password reset links, and as the default CORS origin.
FRONTEND_URL=http://localhost:3000
# Optional comma-separated allowlist. Defaults to FRONTEND_URL when unset.
# CORS_ORIGINS=http://localhost:3000,https://resumexpress.example.com

# ─── Email (password reset) ───────────────────────────────────────────────────
# Optional. When unset, password reset returns a "not configured" error
# instead of failing silently.
# For Gmail this must be an App Password, not the account password.
EMAIL_USER=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ─── AI ───────────────────────────────────────────────────────────────────────
# Server-side only. This key must NEVER be exposed to the browser, which is why
# it has no NEXT_PUBLIC_ prefix and lives in the backend rather than the frontend.
GOOGLE_AI_API_KEY=
# Must be a model your API key can actually serve. A retired or misspelled name
# returns 503 from the provider, which looks like the AI being entirely broken.
# List what your key can use:  client.models.list()
# Verified working: gemini-3.5-flash. "gemini-flash-latest" is an alias that
# tracks the current flash model and survives retirements.
AI_MODEL=gemini-flash-latest

# ─── Time budgets ─────────────────────────────────────────────────────────────
# REQUEST_BUDGET_MS is the one to change. It bounds the WHOLE request and must
# stay BELOW the platform's function timeout (Vercel: Settings > Functions >
# Max Duration). If the platform kills the request first it returns its own
# error page, which has no CORS headers, so the browser reports a misleading
# CORS failure instead of the real cause.
#
# Default 9000 suits Vercel's out-of-the-box ~10s limit. Raise Max Duration
# first, then set this to roughly (Max Duration - 10s).
# Resume generation was measured at ~12s, so a 10s limit cannot fit it:
# raise Max Duration to 60 and set REQUEST_BUDGET_MS=50000.
# REQUEST_BUDGET_MS=9000
#
# AI_BUDGET_MS caps only the AI portion and defaults to REQUEST_BUDGET_MS, so
# you normally leave it unset. Set it only to hold the AI to something tighter
# than the request as a whole — a larger value here cannot exceed the request
# budget and will simply be clamped.
# AI_BUDGET_MS=

# Optional custom font file for embedded Unicode PDF text (absolute server path).
# PDF_FONT_PATH=/srv/fonts/Inter-Regular.ttf
# Temporary request diagnostics, never logs bodies or tokens.
DEBUG_RESUMEXPRESS=0
